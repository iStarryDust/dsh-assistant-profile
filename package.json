{
  "name": "@istarry/dsh-assistant-profile",
  "description": "助理档案：给 DSH 一份全局人格（名称 / 语言 / 人格提示词）与一份长期记忆，每个新会话的系统提示最前面都带着它；聊天里点一下就能把选中的对话提炼进记忆；侧栏「新会话」上方显示助理名；会话行菜单里可以直接删除一个会话（日志、索引、工作区登记一起）",
  "version": "0.7.8",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iStarryDust/dsh-assistant-profile.git"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "LICENSE",
    "README*.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "staging": "node build.mjs --staging",
    "tooling": "cd tooling && pnpm install"
  },
  "dependencies": {},
  "devDependencies": {
    "js-yaml": "4.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.1-rc.2",
    "@deepseek-ai/schemastery": "*"
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  }
}
